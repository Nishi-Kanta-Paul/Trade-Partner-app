# Our own copy of every submission — Supabase → Project Settings → API Keys.
# Leave these unset and the app still works: it just posts to Jotform only
# (the Supabase client is then stripped from the bundle entirely).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The "Publishable key" (sb_publishable_...) — Supabase's new name for the anon
# key. Safe in the browser: row level security limits it to inserts only, see
# supabase/schema.sql. Never put the secret key (sb_secret_...) here.
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Where finished forms are filed — "jotform", "supabase" or "both".
# Unset behaves as "supabase". See src/lib/submit.ts.
VITE_SUBMIT_TARGET=supabase
